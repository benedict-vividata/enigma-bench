# Copy to `.env` beside docker-compose.yml and fill in. Never commit the result.

# --- The run -----------------------------------------------------------------
ENIGMA_BENCH_AGENT=claude          # claude | codex
ENIGMA_BENCH_CODEX_MODEL=gpt-5.6-luna # Codex model when ENIGMA_BENCH_AGENT=codex
ENIGMA_BENCH_HOURS=6               # wall-clock budget; the scorer closes after it
ENIGMA_BENCH_SIZE=large            # benchmark model capacity: small | medium | large
ENIGMA_BENCH_MAX_EVALUATIONS=100   # scored submissions allowed; 0 = unlimited
ENIGMA_BENCH_EVAL_SEED=20260820    # randomise per run to compare agents fairly
ENIGMA_BENCH_PREVIEW=1             # 0 hides held-out plaintext from tool output
ENIGMA_BENCH_OUT=../out             # host directory for run log + transcripts (relative to container/)

# --- Claude Code (subscription) ----------------------------------------------
# On a machine with a browser, with a Pro/Max/Team/Enterprise plan:
#     claude setup-token
# and paste the one-year OAuth token here. Model requests only — it cannot
# establish Remote Control sessions or fetch claude.ai connectors, which is
# exactly what a benchmark run wants.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Codex (ChatGPT plan) ----------------------------------------------------
# Codex has no token equivalent: sign in on a machine with a browser
# (`codex login`) and mount the resulting ~/.codex/auth.json — see
# container/README.md. Treat that file like a password.
